# TMDB API Read Access Token (v4), see https://www.themoviedb.org/settings/api
#
# Deploy (Vercel): add this variable in Settings -> Environment Variables,
# then Redeploy. Vite inlines VITE_* at build time, so a variable added
# after a build has no effect until the next one.
# vercel.json rewrites all routes to index.html (SPA fallback), otherwise
# a refresh on /movie/123 returns 404.
VITE_TMDB_TOKEN=